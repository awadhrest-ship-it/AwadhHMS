PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/awadh_palace_hms
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Photo storage (Phase 5). Housekeeping photos are written to this directory (never into MongoDB).
# Point it at a persistent volume in production; the default is server/uploads.
UPLOAD_DIR=./uploads
# Largest accepted photo in bytes (default 8 MB). The web app shrinks phone photos to ~1600 px before upload.
UPLOAD_MAX_BYTES=8388608
